#!/bin/sh /etc/rc.common
# OpenWrt procd service for evopool_agent.
# Install:
#   cp evopool.init /etc/init.d/evopool && chmod +x /etc/init.d/evopool
#   /etc/init.d/evopool enable && /etc/init.d/evopool start
# Assumes the agent + config.ini live in /opt/evopool/ and python3 + bluez are installed.

START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /opt/evopool/evopool_agent.py
    procd_set_param env EVOPOOL_CONFIG=/opt/evopool/config.ini
    procd_set_param respawn respawn_threshold=60 respawn_timeout=10 respawn_retry=0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
